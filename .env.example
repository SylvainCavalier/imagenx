# =============================================================================
# Environment Variables - Copy this file to .env and fill in your values
# =============================================================================

# --- Database (PostgreSQL) ---
PGUSER=postgres
PGPASSWORD=
PGHOST=localhost
# DATABASE_URL=postgres://user:pass@host:5432/dbname  # Production only

# --- Rails ---
RAILS_ENV=development
RAILS_MASTER_KEY=        # Required in production (see config/master.key)
RAILS_MAX_THREADS=10
RAILS_MIN_THREADS=
RAILS_LOG_LEVEL=info     # debug, info, warn, error, fatal
APP_HOST=localhost       # Production only: public hostname (e.g. app.sbclabs.fr)

# --- Server ---
PORT=3020
WEB_CONCURRENCY=1        # Number of Puma workers in production

# --- Background Jobs (GoodJob) ---
GOOD_JOB_MAX_THREADS=5

# --- Mailer (Sweego SMTP relay, production only) ---
MAILER_FROM=noreply@example.com
SUPPORT_EMAIL=support@example.com
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=

# --- Image generation (Replicate) ---
REPLICATE_API_KEY=

# --- Object storage (OVH, S3-compatible) ---
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=gra
S3_BUCKET_NAME=
S3_ENDPOINT=

# --- Payments (Stripe) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
